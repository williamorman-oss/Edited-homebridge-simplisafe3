{
  "name": "homebridge-simplisafe3-edited",
  "displayName": "SimpliSafe 3 (Edited)",
  "version": "1.12.0-beta.4",
  "private": true,
  "description": "SimpliSafe 3 for Homebridge with faster cameras and Outdoor Camera support. Installs alongside homebridge-simplisafe3.",
  "author": "Niccol\u00f2 Zapponi, shamoon",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/shamoon"
  },
  "bin": {
    "homebridge-simplisafe3-edited": "./bin/run"
  },
  "bugs": {
    "url": "https://github.com/williamorman-oss/Edited-homebridge-simplisafe3/issues"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "0.0.19",
    "@livekit/protocol": "^1.52.1",
    "@oclif/core": "^1",
    "@oclif/plugin-help": "^5",
    "@oclif/plugin-plugins": "^2.0.1",
    "axios": "^1.12.0",
    "axios-retry": "^3.2.4",
    "ffmpeg-for-homebridge": "^2.2.0",
    "is-docker": "^2.2.1",
    "werift": "^0.24.4",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.8",
    "@babel/node": "^7.16.8",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "homebridge": "^2.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "homebridge": ">=1.3.5 || ^2.0.0-beta.0",
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/npm-shrinkwrap.json",
    "/simplisafe.js",
    "/accessories",
    "/commands",
    "/lib",
    "/homebridge-ui",
    "/config.schema.json",
    "/images",
    "/README.md"
  ],
  "homepage": "https://github.com/williamorman-oss/Edited-homebridge-simplisafe3#readme",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "security",
    "simplisafe"
  ],
  "license": "MIT",
  "main": "index.js",
  "oclif": {
    "commands": "./commands",
    "bin": "homebridge-simplisafe3-edited",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "git+https://github.com/williamorman-oss/Edited-homebridge-simplisafe3.git",
  "scripts": {
    "build": "rm -rf dist && babel src -d dist --extensions .js,.ts && cp -r package.json config.schema.json homebridge-ui bin images README.md dist/",
    "deploy": "npm publish dist/",
    "pack": "npm run build && mkdir -p releases && npm pack ./dist --pack-destination releases",
    "start": "nodemon --exec babel-node src/index.js",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.cjs",
    "lint": "eslint src",
    "typecheck": "tsc"
  },
  "overrides": {
    "json-schema": ">=0.4.0"
  }
}
