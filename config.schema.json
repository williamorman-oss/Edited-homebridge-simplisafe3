{
  "pluginAlias": "homebridge-simplisafe3-edited.SimpliSafe 3 Edited",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "*Please note this plugin requires an active SimpliSafe 'interactive' monitoring plan.* This edited version runs alongside homebridge-simplisafe3 with its own SimpliSafe login. Enable it as a child bridge (Bridge Settings) and pair that bridge in the Home app.",
  "customUi": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "SimpliSafe Cameras",
        "placeholder": "e.g. SimpliSafe Cameras"
      },
      "cameras": {
        "title": " Cameras",
        "type": "boolean",
        "default": true,
        "description": "Enable camera support."
      },
      "camerasOnly": {
        "title": " Cameras Only",
        "type": "boolean",
        "default": true,
        "description": "Only add cameras, not the alarm, sensors or locks. Use this to run the cameras on their own child bridge, so camera snapshots never hold up the alarm."
      },
      "debug": {
        "title": " Debug",
        "type": "boolean"
      },
      "subscriptionId": {
        "title": "Account Number",
        "type": "string"
      },
      "sensorRefresh": {
        "title": "Sensor Refresh Interval",
        "type": "integer",
        "default": 15
      },
      "persistAccessories": {
        "title": " Persist Accessories",
        "type": "boolean",
        "default": true
      },
      "logsForClaude": {
        "title": " Keep Logs for Claude",
        "type": "boolean",
        "default": true
      },
      "cameraOptions": {
        "type": "object",
        "properties": {
          "batterySnapshotMinutes": {
            "title": "Battery Camera Snapshot Interval (minutes)",
            "description": "How old a battery camera's snapshot can get before viewing it in the Home app wakes the camera for a new one. Lower values use more battery. Plugged-in cameras refresh every minute.",
            "type": "integer",
            "default": 10,
            "minimum": 1
          },
          "enableHwaccelRpi": {
            "title": " Enable Hardware Acceleration for Raspberry Pi",
            "description": "This may not work if you set the path to use a custom build of ffmpeg",
            "type": "boolean",
            "default": false
          },
          "ffmpegPath": {
            "title": "ffmpeg Path",
            "type": "string",
            "placeholder": "/path/to/custom/ffmpeg",
            "condition": {
              "functionBody": "return (model.cameras || model.camerasOnly)"
            }
          },
          "sourceOptions": {
            "title": "Source Options",
            "type": "string",
            "placeholder": "e.g. -vcodec h264_mmal",
            "condition": {
              "functionBody": "return (model.cameras || model.camerasOnly)"
            }
          },
          "videoOptions": {
            "title": "Video Options",
            "type": "string",
            "placeholder": "e.g. -vcodec h264_omx -tune false",
            "condition": {
              "functionBody": "return (model.cameras || model.camerasOnly)"
            }
          },
          "audioOptions": {
            "title": "Audio Options",
            "type": "string",
            "placeholder": "e.g. -ar 256k",
            "condition": {
              "functionBody": "return (model.cameras || model.camerasOnly)"
            }
          }
        }
      },
      "excludedDevices": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "Serial Number"
        }
      }
    }
  },
  "layout": [{
      "type": "fieldset",
      "items": [
        "name",
        "cameras",
        "camerasOnly"
      ]
    },
    {
      "type": "fieldset",
      "expandable": true,
      "title": "Advanced Camera Settings",
			"condition": {
				"functionBody": "return (model.cameras || model.camerasOnly)"
			},
      "items": [
        "cameraOptions.batterySnapshotMinutes",
        "cameraOptions.enableHwaccelRpi",
        "cameraOptions.ffmpegPath",
        "cameraOptions.sourceOptions",
        "cameraOptions.videoOptions",
        "cameraOptions.audioOptions"
      ]
    },
    {
      "type": "fieldset",
      "expandable": true,
      "title": "Advanced Options",
      "items": [
        {
          "key": "debug",
          "description": "Show extra messages about plugin behavior."
        },
        {
          "key": "subscriptionId",
          "description": "Find your account number under SS web control panel > View Account. See README for more info."
        },
        "sensorRefresh",
        {
          "key": "logsForClaude",
          "description": "Keep this plugin's recent log lines, without passwords, tokens or account numbers, for the 'Logs for Claude' card on this page. Nothing is sent anywhere."
        },
        {
          "key": "persistAccessories",
          "description": "By default, the plugin won't remove old accessories from the Home app. This is to avoid caching issues causing you to lose all your scenes & automations configurations. If you do want to remove old accessories, set this to false."
        },
        {
          "key": "excludedDevices",
          "title": "Excluded Devices",
          "description": "A list of devices to exclude from HomeKit. Uses the device serial number which can be found in the SS app.",
          "add": "Add Another Device",
          "type": "array",
          "items": [
            {
              "type": "fieldset",
              "items": [
                "excludedDevices[]"
              ]
            }
          ]
        }
      ]
    }
  ]
}
